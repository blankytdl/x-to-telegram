# Copy this file to ".env" and fill in your values. Never commit ".env".

# --- X (Twitter) API: developer.x.com -> your app -> Keys and tokens ---
# The app needs "Read" permission. Generate the Access Token/Secret AFTER setting permissions.
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_SECRET=your_access_token_secret

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Channel username (@mychannel) or numeric id (-100123456789). The bot must be a channel admin.
TELEGRAM_CHAT_ID=@mychannel

# --- Optional (defaults shown) ---
POLL_SECONDS=300
MIN_LIKES=0
LIKES_WAIT_MIN=60
THREAD_WAIT_MIN=15
MAX_THREAD_LOOKUPS=5
MAX_PAGES=10
MAX_VIDEO_MB=50
MEDIA_ONLY=1
SEND_CAPTIONS=1
